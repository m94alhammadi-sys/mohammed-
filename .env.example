# ==========================================================
#  المستشار الاقتصادي — ملف الإعدادات
#  انسخ هذا الملف باسم .env وعبِّ القيم
# ==========================================================

# ---------- 1) عقل الوكيل: Claude ----------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-opus-5
# مستوى العمق: low | medium | high | xhigh | max
CLAUDE_EFFORT=high
# تفعيل الاحتياط التلقائي عند رفض النموذج (موصى به)
ENABLE_REFUSAL_FALLBACK=true
# الحد الأقصى لعدد عمليات البحث في الإنترنت لكل رسالة
WEB_SEARCH_MAX_USES=8

# ---------- 2) واتساب ----------
# المزوّد: meta  أو  twilio
WHATSAPP_PROVIDER=meta

# --- إعدادات Meta WhatsApp Cloud API ---
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx
META_PHONE_NUMBER_ID=123456789012345
META_VERIFY_TOKEN=any-random-string-you-choose
# قالب معتمد يُستخدم للتنبيهات خارج نافذة الـ 24 ساعة
META_ALERT_TEMPLATE=market_alert
META_TEMPLATE_LANG=ar

# --- إعدادات Twilio (بديل) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---------- 3) الأمان ----------
# أرقام مسموح لها بالتحدث مع الوكيل (بصيغة دولية، مفصولة بفاصلة)
# اتركه فارغاً للسماح للجميع (غير موصى به)
ALLOWED_NUMBERS=971500000000
# رقمك الأساسي لاستقبال التنبيهات الاستباقية والتقارير اليومية
OWNER_NUMBER=971500000000

# ---------- 4) المنطقة الزمنية والجدولة ----------
TZ=Asia/Dubai
# كل كم دقيقة يفحص الماسح الأسواق بحثاً عن فرص
SCAN_INTERVAL_MINUTES=15
# وقت الموجز الصباحي (بتوقيت TZ)
MORNING_BRIEF_TIME=07:30
# وقت الملخص المسائي
EVENING_BRIEF_TIME=18:30
# الحد الأدنى لقوة الإشارة (0-100) قبل إرسال تنبيه
ALERT_MIN_SCORE=68
# لا تكرر تنبيه نفس الرمز قبل مرور هذه الساعات
ALERT_COOLDOWN_HOURS=6
# الحد الأقصى للتنبيهات في اليوم (حتى لا يزعجك)
MAX_ALERTS_PER_DAY=12

# ---------- 5) التخزين ----------
DB_PATH=data/agent.db
LOG_LEVEL=INFO
PORT=8000
