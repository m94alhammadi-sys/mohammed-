# ── المفتاح الوحيد المطلوب لتشغيل التحليل الحقيقي ─────────────────────
ANTHROPIC_API_KEY=

# ── النماذج ومستوى الجهد ──────────────────────────────────────────────
SPECIALIST_MODEL=claude-opus-5
CHIEF_MODEL=claude-opus-5
# low | medium | high | xhigh | max
SPECIALIST_EFFORT=high
CHIEF_EFFORT=xhigh
MAX_TOKENS=16000

# ── مصادر بيانات اختيارية (غيابها يُعلَن في التقارير ولا يُعطّل النظام) ──
FRED_API_KEY=
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
FINNHUB_API_KEY=
NEWSAPI_KEY=

# ── التشغيل ───────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DB_PATH=majlis.db
AGENT_TIMEOUT_S=240
MAX_EVIDENCE_PER_TOOL=6
HTTP_TIMEOUT_S=15

# اضبطها على 1 لتعطيل النموذج عمداً ورؤية سلوك الوضع المنقطع
OFFLINE_DEMO=0
