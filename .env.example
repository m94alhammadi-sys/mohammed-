# ===== مفتاح الذكاء الاصطناعي (مطلوب) =====
# من console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-opus-5
# عمق التحليل: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_TOKENS=16000

# ===== منصة واتساب: meta أو twilio =====
WHATSAPP_PROVIDER=meta

# --- إعدادات WhatsApp Cloud API (Meta) ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# أي نص تختاره أنت، وتكتبه نفسه في لوحة Meta عند ربط الويبهوك
META_VERIFY_TOKEN=my-verify-token
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_MARK_AS_READ=true

# --- إعدادات Twilio (بديل) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_WEBHOOK_URL=https://your-domain.com/webhook
TWILIO_VALIDATE_SIGNATURE=true

# ===== التحكم بالوصول =====
# أرقام مسموح لها فقط (بأي تنسيق). اتركه فارغاً ليكون مفتوحاً للجميع.
ALLOWED_NUMBERS=+971501234567
MESSAGES_PER_HOUR=30
MAX_INBOUND_CHARS=4000
OUTBOUND_CHUNK_SIZE=3500

# ===== الموجز اليومي =====
BRIEFING_ENABLED=true
# صيغة cron: دقيقة ساعة يوم شهر يوم-الأسبوع (7 صباحاً يومياً)
BRIEFING_CRON=0 7 * * *
BRIEFING_TIMEZONE=Asia/Dubai
BRIEFING_SUBSCRIBERS=

# ===== أدوات الإنترنت =====
MAX_WEB_SEARCHES=8
MAX_WEB_FETCHES=5
ENABLE_WEB_FETCH=true
ENABLE_REFUSAL_FALLBACK=true
# لنماذج أقدم استخدم: web_search_20250305 و web_fetch_20250910
WEB_SEARCH_TOOL_TYPE=web_search_20260209
WEB_FETCH_TOOL_TYPE=web_fetch_20260209

# ===== مصادر إخبارية إضافية (اختياري) =====
# الصيغة: الاسم|الرابط|اللغة  ويفصل بينها بفاصلة
EXTRA_FEEDS=

# ===== تشغيل =====
PORT=3000
DATA_DIR=./data
LOG_LEVEL=info
