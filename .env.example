# ============================================================
#  إعدادات ايجنت تداول الميم كوينز — انسخ هذا الملف إلى .env
#  cp .env.example .env
# ============================================================

# --- الوضع ---
# true = تداول وهمي (ما يصرف أي SOL حقيقي). خله true لين تتأكد من النتائج!
DRY_RUN=true
# رصيد SOL الوهمي في وضع DRY_RUN
PAPER_START_SOL=1

# --- المحفظة ---
# المفتاح الخاص (Base58) من Phantom: Settings > Manage Accounts > [الحساب] > Show Private Key
# ⚠️ استخدم محفظة جديدة مخصصة للبوت فيها مبلغ صغير بس. لا تشارك المفتاح مع أي أحد.
PRIVATE_KEY=
# RPC خاص أسرع وأثبت (Helius / QuickNode / Triton). العام بطيء وفيه حدود.
RPC_URL=https://api.mainnet-beta.solana.com

# --- حجم الصفقات وإدارة المخاطر ---
BUY_AMOUNT_SOL=0.05          # كم SOL لكل صفقة
MAX_OPEN_POSITIONS=3         # أقصى عدد صفقات مفتوحة بنفس الوقت
MAX_TOTAL_EXPOSURE_SOL=0.2   # أقصى مجموع SOL داخل صفقات مفتوحة
MIN_SOL_RESERVE=0.05         # رصيد يبقى دايماً للرسوم وما يتداول فيه
DAILY_LOSS_LIMIT_SOL=0.1     # إذا الخسارة اليومية وصلت هذا الرقم يوقف الشراء لين باچر (UTC)
SLIPPAGE_BPS=1500            # 1500 = 15% انزلاق سعري مسموح (الميم كوينز متقلبة)
MAX_PRICE_IMPACT_PCT=5       # يرفض الصفقة إذا تأثير السعر أكبر من هذا
PRIORITY_FEE_MAX_LAMPORTS=200000

# --- الخروج من الصفقة ---
TAKE_PROFIT_PCT=50           # يبيع إذا الربح +50%
STOP_LOSS_PCT=20             # يبيع إذا الخسارة -20%
TRAILING_STOP_PCT=15         # بعد ما يربح، يبيع إذا نزل 15% من أعلى قيمة
TRAILING_ACTIVATION_PCT=20   # التريلنق يشتغل بعد ربح +20%
MAX_HOLD_MINUTES=60          # يبيع بعد هالمدة مهما كان

# --- فلاتر اختيار العملات (من DexScreener) ---
MIN_LIQUIDITY_USD=20000
MAX_LIQUIDITY_USD=2000000
MIN_VOLUME_H1_USD=20000
MIN_PAIR_AGE_MINUTES=30      # تجنب العملات اللي توها نازلة (أغلب الـ rugs)
MAX_PAIR_AGE_MINUTES=4320    # 3 أيام
MAX_FDV_USD=20000000
MIN_BUY_SELL_RATIO=1.2       # نسبة عمليات الشراء للبيع آخر ساعة
MIN_PRICE_CHANGE_H1_PCT=5
MAX_PRICE_CHANGE_H1_PCT=300  # تجنب اللي طار بزيادة (غالباً قمة)

# --- فحوصات الأمان ---
REQUIRE_NO_MINT_AUTHORITY=true    # يرفض العملة إذا المطور يقدر يطبع توكنات جديدة
REQUIRE_NO_FREEZE_AUTHORITY=true  # يرفض العملة إذا المطور يقدر يجمد محفظتك
USE_RUGCHECK=true                 # فحص إضافي من rugcheck.xyz
RUGCHECK_MAX_SCORE=1000           # كل ما زاد الرقم زادت المخاطر
BLACKLIST=                        # عناوين عملات مفصولة بفواصل

# --- التشغيل ---
POLL_INTERVAL_SECONDS=20
JUPITER_API=https://lite-api.jup.ag/swap/v1
