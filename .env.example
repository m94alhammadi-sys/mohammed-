# ── مفاتيح أساسية ─────────────────────────────────────────────
# مفتاح Claude من https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# توكن بوت تيليجرام من @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ── إعدادات اختيارية ──────────────────────────────────────────
# الموديل (الافتراضي: claude-opus-5)
ADVISOR_MODEL=claude-opus-5

# عمق التفكير: low | medium | high | xhigh | max
ADVISOR_EFFORT=high

# المنطقة الزمنية للتقرير اليومي
ADVISOR_TIMEZONE=Asia/Dubai

# وقت التقرير الصباحي اليومي (24 ساعة، بتوقيت المنطقة أعلاه)
ADVISOR_BRIEF_HOUR=8
ADVISOR_BRIEF_MINUTE=0

# أرقام تيليجرام المسموح لها (فاضي = الكل مسموح). مثال: 123456789,987654321
ADVISOR_ALLOWED_USER_IDS=

# مسار قاعدة البيانات
ADVISOR_DB_PATH=advisor_data.sqlite3

# ── واتساب (اختياري — Meta WhatsApp Cloud API) ────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=my-verify-token
