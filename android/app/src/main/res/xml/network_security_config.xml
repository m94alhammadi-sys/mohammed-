<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      التطبيق يتصل بـ api.anthropic.com عبر HTTPS حصراً، فلا حاجة
      للسماح بـ HTTP الصريح. المنع هنا مقصود لا سهو.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
